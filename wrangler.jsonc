{
  "name": "listing-lens",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  // The Cloudflare account kept for the hackathon apps (Workers Free plan).
  "account_id": "9fc5652f61b1f60eb20e1d9a2ef70041",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/mcp", "/s/*", "/health"] },
  "ai": { "binding": "WRITER", "remote": true },
  // DB is this app's own (the Qloo cache, saved briefs, the run cache). LEDGER is shared by the hackathon apps, so each
  // writing call is counted there and the apps stay inside the shared daily allowance.
  "d1_databases": [
    { "binding": "DB", "database_name": "listing-lens", "database_id": "78a92f54-029c-4b4d-b3f9-1e6fce802917", "migrations_dir": "migrations" },
    // Remote calls count in the shared ledger because they spend the same daily allowance.
    { "binding": "LEDGER", "database_name": "hackathon-ledger", "database_id": "023377a8-ad19-413c-b769-d195d05427b3", "remote": true }
  ],
  "durable_objects": { "bindings": [{ "name": "COUNTERS", "class_name": "DailyCounter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DailyCounter"] }],
  "observability": { "enabled": false }
}
