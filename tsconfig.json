{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "skipLibCheck": true, "isolatedModules": true, "resolveJsonModule": true, "allowJs": true, "checkJs": false,
    "types": ["node"]
  },
  "include": ["src/mcp", "src/qloo", "src/agent", "src/store", "src/app", "src/paypal", "tests"]
}
